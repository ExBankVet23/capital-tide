# Copy this file to ".env" (same folder as fetch_data.py) and fill in your
# real keys. The .env file persists across every future run — no need to
# re-export in each new terminal session.
#
# NEVER commit your actual ".env" file to a public repo — only this
# ".env.example" template should be committed. Add ".env" to your
# .gitignore.

FRED_API_KEY=your_fred_key_here
COINGECKO_API_KEY=your_coingecko_key_here
